<svg width="600" height="900" xmlns="http://www.w3.org/2000/svg">
  <!-- Background gradient (evening time) -->
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#2d283e;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1a1625;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="lineGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" style="stop-color:#564f6f;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#7e6fa0;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#9d8fc1;stop-opacity:1" />
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="600" height="900" fill="url(#bgGrad)"/>

  <!-- Rotated lines (45 degree angle for aesthetic thumbnail) -->
  <g transform="translate(300, 450) rotate(45)">
    <line x1="-250" y1="-150" x2="250" y2="-150" stroke="url(#lineGrad)" stroke-width="8" stroke-linecap="round"/>
    <line x1="-250" y1="-110" x2="250" y2="-110" stroke="url(#lineGrad)" stroke-width="8" stroke-linecap="round"/>
    <line x1="-250" y1="-70" x2="250" y2="-70" stroke="url(#lineGrad)" stroke-width="8" stroke-linecap="round"/>
    <line x1="-250" y1="-30" x2="250" y2="-30" stroke="url(#lineGrad)" stroke-width="8" stroke-linecap="round"/>
    <line x1="-250" y1="10" x2="250" y2="10" stroke="url(#lineGrad)" stroke-width="8" stroke-linecap="round"/>
    <line x1="-250" y1="50" x2="250" y2="50" stroke="url(#lineGrad)" stroke-width="8" stroke-linecap="round"/>
    <line x1="-250" y1="90" x2="250" y2="90" stroke="url(#lineGrad)" stroke-width="8" stroke-linecap="round"/>
    <line x1="-250" y1="130" x2="250" y2="130" stroke="url(#lineGrad)" stroke-width="8" stroke-linecap="round"/>
  </g>
</svg>